FROM golang:1.25-bookworm AS build
WORKDIR /source
COPY . .
WORKDIR /source/services/persistence
RUN go mod download && CGO_ENABLED=0 go build -trimpath -o /remote-server-pg ./cmd/remote-server-pg
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /remote-server-pg /usr/local/bin/remote-server-pg
USER 65532:65532
ENTRYPOINT ["remote-server-pg"]
CMD ["run","--config","/state/server.json"]
